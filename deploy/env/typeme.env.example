# /etc/typeme/typeme.env —— 只放占位符，真实值由部署人员在服务器上填写。
# 权限 600，属主为运行用户。不要提交真实值，不要贴进日志或对话。

# ── 数据库（必填）──────────────────────────────────────────────────────────
# 专用库、专用账号（权限见 docs/2026-10-27/部署与数据库处理方案.md §5.1）。
TYPEME_DB_URL=jdbc:mysql://<db-host>:3306/<DB_NAME>?useSSL=true&serverTimezone=UTC&characterEncoding=UTF-8
TYPEME_DB_USER=<app_user>
TYPEME_DB_PASSWORD=<set-on-server>

# ── 注册验证码（必填）──────────────────────────────────────────────────────
# >=32 位随机串，例如：openssl rand -base64 48
TYPEME_CAPTCHA_SECRET=<set-on-server>

# ── 反向代理（有 Nginx/负载均衡时必填）────────────────────────────────────
# Nginx 的地址或网段（逗号分隔）。不配则所有请求的来源 IP 都是代理地址，限流会互相误伤。
TYPEME_TRUSTED_PROXIES=127.0.0.1

# ── 首个管理员（仅第一次部署；成功后删除 PASSWORD 这一行并重启）──────────────
TYPEME_ADMIN_BOOTSTRAP_USERNAME=<admin-username>
#TYPEME_ADMIN_BOOTSTRAP_PASSWORD=<set-on-server-once>

# ── AI（可选；默认关闭，关闭不影响基础测评与固定报告）─────────────────────
# 真实调用与个人数据外发需要用户授权后再开启。
TYPEME_AI_ENABLED=false
#TYPEME_AI_BASE_URL=<provider-base-url>
#TYPEME_AI_API_KEY=<set-on-server>
# 想在后台页面保存 Key 时需要（>=16 位）；轮换会使已存 Key 无法解密。
#TYPEME_SETTINGS_SECRET=<set-on-server>
