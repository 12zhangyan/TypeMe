{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "referenceType", "summary", "observations", "suggestedAction", "limitations"],
  "properties": {
    "schemaVersion": {"const": "analysis-readable-v2"},
    "referenceType": {"type": ["string", "null"], "pattern": "^[EI][SN][TF][JP]$"},
    "summary": {"type": "string", "minLength": 1, "maxLength": 200},
    "observations": {"type": "array", "maxItems": 2, "items": {
      "type": "object", "additionalProperties": false,
      "required": ["plainText", "example", "evidenceIds"],
      "properties": {
        "plainText": {"type": "string", "minLength": 1, "maxLength": 180},
        "example": {"type": ["string", "null"], "minLength": 1, "maxLength": 120},
        "evidenceIds": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }},
    "suggestedAction": {"anyOf": [{"type": "null"}, {
      "type": "object", "additionalProperties": false,
      "required": ["what", "when", "observe", "evidenceIds"],
      "properties": {
        "what": {"type": "string", "minLength": 1, "maxLength": 120},
        "when": {"type": "string", "minLength": 1, "maxLength": 120},
        "observe": {"type": "string", "minLength": 1, "maxLength": 120},
        "evidenceIds": {"type": "array", "minItems": 1, "maxItems": 8, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }]},
    "limitations": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"type": "string", "minLength": 1, "maxLength": 160}}
  }
}
